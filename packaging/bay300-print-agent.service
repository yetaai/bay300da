[Unit]
Description=Bay300 store Bill print agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/bay300-print-agent/venv/bin/bay300-print-agent run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bay300-print-agent %h/.config/bay300-print-agent

[Install]
WantedBy=default.target
