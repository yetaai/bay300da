[Unit]
Description=Bay300 store device agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/bay300-device-agent/venv/bin/bay300da run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bay300-device-agent %h/.bay300

[Install]
WantedBy=default.target
